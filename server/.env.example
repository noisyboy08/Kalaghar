# ─────────────────────────────────────────────────────────────────────────────
# Kalaghar Server — Environment Variables
# Copy this file to config.env (at the repo root) and fill in real values.
# NEVER commit config.env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── CORS — comma-separated list of allowed origins ───────────────────────────
# Example: https://kalaghar-admin.vercel.app,https://kalaghar.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Create a dedicated database user (NOT the cluster admin)
DB_USERNAME=your_atlas_db_username
DB_PASSWORD=your_atlas_db_password
DB_HOST=cluster0.your_atlas_host.mongodb.net

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex').then(console.log)"
JWT_SECRET=replace_with_64_byte_random_hex_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace_with_different_64_byte_random_hex_string
JWT_REFRESH_EXPIRES=30d

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Create a dedicated upload preset for Kalaghar
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Use TEST keys in development, LIVE keys in production
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Download the service account JSON from Firebase Console
# Option A: path to the JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json
# Option B: inline JSON (useful for deploy platforms — escape the JSON as a single line)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ─────────────────────────────────────────────────────────────────────────────
# DEPLOYMENT NOTES
# ─────────────────────────────────────────────────────────────────────────────
# Deploy the backend on an ALWAYS-ON host tier (not the free tier that sleeps):
#   - Render: use a "Starter" or higher plan (free plan sleeps after 15min)
#   - Railway: Hobby or Pro plan
#   - Fly.io: Machines tier (always on by default)
#
# MongoDB:
#   - Use MongoDB Atlas M0 (free) is fine for development
#   - For production, use M10 or higher for dedicated resources
#   - IP allowlist: add the deploy host's static IP or allow 0.0.0.0/0 (less secure)
#
# Run database seed: npm run seed
# Run tests: npm test
# Start dev server: npm run dev
# Start production: npm start
